# ============================================================
# CIVIC EYE Backend — Environment Variable Reference
# Copy this to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- MongoDB ---
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=civic_eye

# --- Security ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CITY_TEAM_ACCESS_CODE=<generate-a-random-secret-at-least-32-characters>
# Each department needs a separate random secret of at least 16 characters.
CIVIC_DEPT_ROAD_MAINTENANCE_ACCESS_CODE=<road-maintenance-secret>
CIVIC_DEPT_ROADS_ENGINEERING_ACCESS_CODE=<roads-engineering-secret>
CIVIC_DEPT_MUNICIPAL_SANITATION_ACCESS_CODE=<municipal-sanitation-secret>
CIVIC_DEPT_WATER_SUPPLY_ACCESS_CODE=<water-supply-secret>
CIVIC_DEPT_DRAINAGE_ACCESS_CODE=<drainage-secret>
CIVIC_DEPT_ELECTRICAL_MAINTENANCE_ACCESS_CODE=<electrical-maintenance-secret>
CIVIC_DEPT_GENERAL_ACCESS_CODE=<general-services-secret>

# --- AI Engine ---
# Provider is required for automated report review.
AI_PROVIDER=groq
AI_MODEL=gemini-3.8-flash
AI_API_KEY=<your-gemini-api-key>
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-20b

# --- File Storage ---
# Local directory (relative to project root) or an S3-compatible URL
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
MAX_VIDEO_SIZE_MB=12
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg,audio/mp4
ALLOWED_VIDEO_TYPES=video/mp4,video/webm

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Geospatial ---
# Radius (in metres) for duplicate-detection candidate search
DEDUP_RADIUS_METERS=150
# Radius (in metres) for repair-evidence geofence check
REPAIR_GEOFENCE_METERS=30

# --- SLA defaults (hours) ---
SLA_CRITICAL_HOURS=24
SLA_HIGH_HOURS=72
SLA_MEDIUM_HOURS=168
SLA_LOW_HOURS=336

# --- Application ---
APP_NAME=CIVIC EYE
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
